{
  "name": "@hedginxyz/sdk",
  "version": "0.8.0",
  "description": "TypeScript client for the Hedge Vault manager bot API (V1): reads, safe local signing, and one-call execution.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HedginVault/sdk.git"
  },
  "homepage": "https://github.com/HedginVault/sdk#readme",
  "bugs": {
    "url": "https://github.com/HedginVault/sdk/issues"
  },
  "keywords": [
    "solana",
    "hedge-vault",
    "hedgin",
    "sdk",
    "defi"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hedge-check-api": "dist/check-api.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-api": "tsx --env-file=.env src/check-api.ts",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "yarn run check && yarn test",
    "sync-idl": "node scripts/sync-idl.mjs"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "bs58": "4.0.1",
    "buffer": "^6.0.3",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "@types/bs58": "4.0.4",
    "@types/node": "^20",
    "esbuild": "~0.28.0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
