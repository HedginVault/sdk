{
  "name": "@hedginvault/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the Hedge Vault manager bot API (V1): reads, safe local signing, and one-call execution.",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hedge-check-api": "dist/check-api.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-api": "tsx --env-file=.env src/check-api.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "bs58": "4.0.1",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "@types/bs58": "4.0.4",
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
